<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_fondo_encabezado"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="44dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Ciencia" />

            <TextView
                android:id="@+id/tvNivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/quiz_fondo_etiqueta"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:textColor="@color/quiz_encabezado"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Nivel Facil" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-18dp"
            android:background="@drawable/quiz_fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextoTituloQuiz"
                android:text="@string/quiz_instrucciones_titulo" />

            <TextView
                style="@style/TextoParrafoQuiz"
                android:layout_marginTop="8dp"
                android:text="@string/quiz_instrucciones" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorPreguntas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvValidacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/quiz_fondo_tarjeta"
            android:padding="16dp"
            android:textColor="@color/quiz_historia"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Faltan por responder: 2, 4"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnFinalizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="26dp"
            android:backgroundTint="@color/quiz_cultura"
            android:minHeight="56dp"
            android:text="@string/accion_finalizar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/quiz_encabezado"
            android:minHeight="56dp"
            android:text="@string/accion_reiniciar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRegresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/quiz_regresar"
            android:minHeight="54dp"
            android:text="@string/accion_regresar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
