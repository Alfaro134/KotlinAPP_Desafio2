<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quiz_fondo_encabezado"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="44dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_titulo"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quiz_subtitulo"
                android:textColor="@color/quiz_texto_claro"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-18dp"
            android:background="@drawable/quiz_fondo_tarjeta"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextoTituloQuiz"
                android:text="@string/quiz_instrucciones_titulo" />

            <TextView
                style="@style/TextoParrafoQuiz"
                android:layout_marginTop="8dp"
                android:text="@string/quiz_instrucciones" />
        </LinearLayout>

        <TextView
            style="@style/TextoTituloQuiz"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:text="@string/quiz_dificultad" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/quiz_fondo_tarjeta"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <RadioGroup
                android:id="@+id/grupoDificultad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioFacil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/quiz_nivel_facil"
                    android:textColor="@color/quiz_texto"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/radioDificil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quiz_nivel_dificil"
                    android:textColor="@color/quiz_texto"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quiz_dificultad_detalle"
                android:textColor="@color/quiz_texto_suave"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/TextoTituloQuiz"
            android:layout_marginStart="24dp"
            android:layout_marginTop="26dp"
            android:text="@string/quiz_tipo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCulturaGeneral"
                style="@style/BotonTipoQuiz"
                android:backgroundTint="@color/quiz_cultura"
                android:text="@string/quiz_tipo_cultura" />

            <Button
                android:id="@+id/btnCiencia"
                style="@style/BotonTipoQuiz"
                android:layout_marginStart="14dp"
                android:backgroundTint="@color/quiz_ciencia"
                android:text="@string/quiz_tipo_ciencia" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeportes"
                style="@style/BotonTipoQuiz"
                android:backgroundTint="@color/quiz_deportes"
                android:text="@string/quiz_tipo_deportes" />

            <Button
                android:id="@+id/btnHistoria"
                style="@style/BotonTipoQuiz"
                android:layout_marginStart="14dp"
                android:backgroundTint="@color/quiz_historia"
                android:text="@string/quiz_tipo_historia" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/quiz_regresar"
            android:minHeight="54dp"
            android:text="@string/accion_cerrar_sesion"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
