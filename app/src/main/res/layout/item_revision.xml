<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/quiz_fondo_tarjeta"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvEnunciado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/quiz_texto"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="1. Cual es la formula quimica del agua?" />

    <TextView
        android:id="@+id/tvTuRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Tu respuesta: H2O" />

    <TextView
        android:id="@+id/tvCorrecta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/quiz_texto_suave"
        android:textSize="15sp"
        tools:text="Respuesta correcta: H2O" />
</LinearLayout>
